# === ETHAR LABS UK LTD — Production (copy to .env on server) ===
DEBUG=false
PORT=8000

# Public URLs (required for Telegram links & pitch CRM)
PUBLIC_API_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com
REQUIRE_ORDER_ACCESS_TOKEN=true
RATE_LIMIT_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:///./data/agency.db
DATABASE_URL_SYNC=sqlite:///./data/agency.db

# Realistic human pacing (1 hour between desks)
STAGE_DELAY_SECONDS=3600

# Real USDT settlement
USDT_BEP20_WALLET=0xYourBEP20Wallet
USDT_TRC20_WALLET=TYourTRC20Wallet
BSCSCAN_API_KEY=your_bscscan_key
TRON_API_KEY=

STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_REFERENCE_PREFIX=STRIPE-TEST-
ALLOW_TEST_PAYMENTS=false
PAYMENT_AMOUNT_TOLERANCE_USD=1.0

# LLM (OpenAI / OpenRouter / DeepSeek / Gemini OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=90
OPENROUTER_HTTP_REFERER=https://yourdomain.com
OPENROUTER_APP_TITLE="ETHAR LABS UK LTD"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_SECRET=use-openssl-rand-hex-32
