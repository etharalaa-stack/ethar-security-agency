# Paste into Coolify → Resource → Environment (production). Replace YOUR_PUBLIC_URL.
DEBUG=false
PORT=8000
PAYMENT_USDT_ONLY=true
ALLOW_TEST_PAYMENTS=false
REQUIRE_ORDER_ACCESS_TOKEN=true
RATE_LIMIT_ENABLED=true
TRUSTED_HOSTS=YOUR_PUBLIC_URL_HOST

# After Coolify assigns domain (or http://128.140.121.115:PORT for raw IP test)
PUBLIC_API_BASE_URL=https://YOUR_PUBLIC_URL
FRONTEND_URL=https://YOUR_PUBLIC_URL
CORS_ORIGINS=*

DATABASE_URL=sqlite+aiosqlite:///./data/agency.db
DATABASE_URL_SYNC=sqlite:///./data/agency.db
STAGE_DELAY_SECONDS=60

USDT_BEP20_WALLET=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb0
USDT_TRC20_WALLET=TYourTRC20WalletAddressHere
BSCSCAN_API_KEY=
TRON_API_KEY=

STRIPE_TEST_REFERENCE_PREFIX=STRIPE-TEST-
PAYMENT_AMOUNT_TOLERANCE_USD=1.0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=90
OPENROUTER_HTTP_REFERER=https://YOUR_PUBLIC_URL
OPENROUTER_APP_TITLE="ETHAR LABS UK LTD"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_SECRET=REPLACE_WITH_openssl_rand_hex_32
